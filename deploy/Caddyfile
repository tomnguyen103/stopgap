# Caddy edge for the Stopgap VPS (PROJECT_PLAN §11). Auto-TLS via Let's Encrypt.
#
# Only the console is public, and only because it runs in demo mode (read-only: reviews and
# exception resolutions are refused server-side, not just hidden). The Temporal UI and
# Langfuse both expose case data and prompt text, and neither has an auth layer of its own
# worth the name here — so both sit behind basic auth. See PHASE5-TODO.md "Auth".

# HSTS lives HERE and not in `next.config.ts` (P4.5). A header promising HTTPS, emitted by an
# application that may be reached over plain HTTP behind a proxy, is a promise the application
# cannot keep — Caddy is the only process in this deployment that knows the connection is TLS.
#
# Two years, subdomains included. No `preload`: that is a one-way submission to a browser-vendor
# list, and it should be a deliberate decision by whoever owns the domain rather than a side
# effect of a design programme.
(hsts) {
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
}

{$APP_DOMAIN} {
	encode zstd gzip
	import hsts
	reverse_proxy console:3000
}

# OIDC IdP (Keycloak, PHASE6 §6.1). Public — it has its own login and manages the console's SSO,
# so no basic-auth layer here (that would block the sign-in redirect). Keycloak runs with
# KC_PROXY_HEADERS=xforwarded + KC_HOSTNAME=https://{$AUTH_DOMAIN}, so Caddy terminates TLS and
# forwards the forwarded-proto/host headers it expects.
{$AUTH_DOMAIN} {
	encode zstd gzip
	import hsts
	reverse_proxy keycloak:8080
}

# Visitors can watch real durable workflows execute — behind basic auth, because the Temporal
# UI can also terminate them.
{$TEMPORAL_DOMAIN} {
	encode zstd gzip
	import hsts
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	reverse_proxy temporal-ui:8080
}

# Langfuse has its own login; the basic-auth layer in front of it keeps the signup page from
# being reachable by anyone who finds the subdomain.
{$TRACES_DOMAIN} {
	encode zstd gzip
	import hsts
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	reverse_proxy langfuse-web:3000
}

# Grafana (PHASE6 §6.4). The ops and business dashboards expose case volumes and queue depth, and
# Grafana's own admin login is only as good as GRAFANA_ADMIN_PASSWORD — so the same basic-auth
# layer as the Temporal UI sits in front. Without this route the provisioned dashboards are
# unreachable in the deployed stack: no container publishes a port except Caddy.
{$OPS_DOMAIN} {
	encode zstd gzip
	import hsts
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	reverse_proxy grafana:3000
}
