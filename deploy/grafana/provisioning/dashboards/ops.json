{
  "uid": "stopgap-ops",
  "title": "Ops",
  "tags": ["stopgap", "ops"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Feed freshness (staleness seconds)",
      "description": "Seconds since each source's newest stored feed record. Rising line = poller falling behind; FeedStale fires above 2700s (45m).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stopgap_feed_staleness_seconds",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Worker liveness",
      "description": "up{job=\"stopgap-worker\"}: 1 = scrape succeeding, 0 = WorkerDown.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"stopgap-worker\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Exception queue depth",
      "description": "Cases sitting in the exception queue awaiting human resolution.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stopgap_exception_queue_depth"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Workflow task failures",
      "description": "Per-second rate of activity failures, by activity. Sustained non-zero means a workflow activity is erroring.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(stopgap_workflow_task_failures_total[5m])",
          "legendFormat": "{{activity}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Critical unacked (max seconds)",
      "description": "Max age of an unacknowledged critical case. CriticalCaseUnacked fires above 3600s (60m policy limit).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1800 }, { "color": "red", "value": 3600 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stopgap_critical_case_unacked_seconds"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Comms delivered vs non-delivered",
      "description": "Per-second rate of comms outcomes by channel. Non-delivery is recorded honestly, never faked — a rising non-delivered rate is a real signal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(stopgap_comms_delivered_total[5m])",
          "legendFormat": "delivered {{channel}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(stopgap_comms_nondelivered_total[5m])",
          "legendFormat": "non-delivered {{channel}}"
        }
      ]
    }
  ]
}
