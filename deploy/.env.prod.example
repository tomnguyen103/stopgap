# Stopgap VPS deployment — copy to deploy/.env and fill in. Never commit the filled file.
# Generate every secret below with `openssl rand -hex 32` unless noted otherwise.

# --- domains (point A/AAAA records at the VPS before starting Caddy) ---
APP_DOMAIN=stopgap.example.com
TEMPORAL_DOMAIN=temporal.stopgap.example.com
TRACES_DOMAIN=traces.stopgap.example.com
# OIDC IdP (Keycloak) domain. Add a Caddy route for it (reverse_proxy keycloak:8080).
AUTH_DOMAIN=auth.stopgap.example.com
# Grafana (ops + business dashboards), served through Caddy behind the same basic auth.
OPS_DOMAIN=ops.stopgap.example.com

# Basic auth for the Temporal UI and Langfuse. Hash: `caddy hash-password --plaintext '<pw>'`
# IMPORTANT: docker compose interpolates `$` in this file, so DOUBLE every `$` in the bcrypt
# hash ($2a$14$... becomes $$2a$$14$$...). Unescaped, compose eats the segments and Caddy
# starts with a truncated hash that no password matches.
BASIC_AUTH_USER=viewer
BASIC_AUTH_HASH=$$2a$$14$$replace_with_a_real_bcrypt_hash

# --- datastores ---
# BOTH POSTGRES PASSWORDS MUST BE URL-SAFE. GENERATE THEM WITH `openssl rand -hex 32` (the default
# instruction at the top of this file) OR `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` —
# hex and base64url, and nothing hand-picked.
#
# WHY, because it is not obvious and the failure points nowhere near the cause: compose interpolates
# these values RAW into a connection URL (`postgres://stopgap_app:<pw>@postgres:5432/stopgap`),
# while `deploy/postgres/app-role.sql` sets the same value through psql's quoting, which escapes
# anything. So a password containing `@ / : # ?` is set CORRECTLY in Postgres and then mis-parsed in
# the URL — `@` ends the userinfo early, `/` ends the authority — and the deploy fails
# authentication against a password that is, in the database, exactly right. Constraining generation
# is the smaller and more reliable contract than percent-encoding at every interpolation site.
#
# Owner/superuser role. Used by the migration job and by DATABASE_URL_MAINTENANCE (the cross-tenant
# connection the authentication bootstrap, audit anchoring and verification run on).
POSTGRES_PASSWORD=
# The NON-superuser role the application itself connects as (PHASE6 §6.5). This is what makes the
# row-level security policies apply at all: a superuser bypasses every one of them, so an app
# connecting as POSTGRES_USER has tenant isolation installed and enforcing nothing. Created by the
# `app-role-init` service; the deploy refuses to start if this is unset or empty.
APP_DB_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_USER=stopgap
MINIO_PASSWORD=

# --- Langfuse ---
LANGFUSE_SALT=
# Must be exactly 64 hex characters.
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ADMIN_EMAIL=you@example.com
LANGFUSE_ADMIN_PASSWORD=
# These two also go to the app as its tracing credentials; any stable strings work.
LANGFUSE_PUBLIC_KEY=pk-lf-stopgap-prod
LANGFUSE_SECRET_KEY=

# --- model routing ---
# "gemini" spends money and needs GEMINI_API_KEY; "ollama" is free and runs in-cluster on CPU.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_MODEL=mistral

# --- demo mode (PROJECT_PLAN §11) ---
# "on" = public read-only demo: reviews/exception resolutions refused, "Run a shortage" allowed.
STOPGAP_DEMO_MODE=on
# Daily LLM spend cap in USD, applied to every caller (visitors and scheduled polls alike).
# Over it, routing is restricted to the free local model and the console banner says so.
# Leave unset for no cap.
LLM_DAILY_USD_CAP=2   # blank = no cap
DEMO_MAX_RUNS_PER_HOUR=6
# Aggregate per public demo tenant, per rolling hour; protects paid providers from cookie churn.
DEMO_MAX_RUNS_PER_HOUR_TOTAL=60

# --- OIDC SSO / RBAC (PHASE6 §6.1) ---
# Honest non-configuration: with STOPGAP_DEMO_MODE=on above, blank AUTH_SECRET /
# KEYCLOAK_CLIENT_SECRET leaves an anonymous read-only demo. If demo mode is turned off before
# both are filled, the console fails closed with 503. Set both and keep demo mode off to enforce
# the role matrix. `openssl rand -base64 33` for AUTH_SECRET.
AUTH_SECRET=
KEYCLOAK_ISSUER=https://auth.stopgap.example.com/realms/stopgap
KEYCLOAK_CLIENT_ID=stopgap-console
# The seeded realm ships a DEV secret (stopgap-console-dev-secret) — ROTATE it in Keycloak and
# put the new value here for a real deployment.
KEYCLOAK_CLIENT_SECRET=
# Keycloak bootstrap admin (first boot only). Rotate after the realm is seeded.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- optional integrations (each degrades honestly when absent) ---
OPENFDA_API_KEY=
ASHP_AUTH_KEY=
RESEND_API_KEY=
COMMS_FROM=stopgap@example.com
COMMS_PHARMACY_TO=
COMMS_DEMO_INBOX=
EHR_WEBHOOK_URL=

# --- observability (PHASE6 §6.4) ---
# Grafana admin login (the dashboards themselves are behind Caddy basic auth at $OPS_DOMAIN).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# On-call alert routing. REQUIRED: the prod Alertmanager config reads the Slack webhook from this
# file, and compose refuses to start without it — a deployment must not come up with alerting that
# pages nobody. Create it with `install -m 600 /dev/null ./alertmanager-slack-webhook` and paste
# the webhook URL in as the only line.
ALERTMANAGER_SLACK_WEBHOOK_FILE=./alertmanager-slack-webhook
