# --- Stopgap environment (copy to .env; .env is gitignored) ---

# Postgres (app DB). docker-compose provisions this locally.
DATABASE_URL=postgres://stopgap:stopgap@localhost:5433/stopgap

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=stopgap-cases

# --- LLM provider routing ---
# Prod default. If GEMINI_API_KEY is absent, the Gemini provider is stubbed and
# routing falls back to Ollama (see PHASE5-TODO.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local dev / CI / runtime fallback. Ollama must be running locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Provider preference: "gemini" (prod) or "ollama" (dev/ci). CI sets "ollama".
LLM_PROVIDER=ollama

# --- Feeds (all REAL, live; no key required) ---
OPENFDA_BASE_URL=https://api.fda.gov
# openFDA allows more requests/day with a free key; optional.
OPENFDA_API_KEY=
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov
ASHP_FEED_URL=https://raw.githubusercontent.com/ASHP-Software/drugShortagesDoc/master

# --- Observability (Phase 2) ---
# Tracing stays OFF unless both keys are set. Self-hosted Langfuse:
#   docker compose --profile langfuse up -d
# seeds this local project (see docker-compose.yml LANGFUSE_INIT_*), UI on :3001.
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Outbound comms (Phase 4). Stubbed if absent. ---
# Without RESEND_API_KEY the send is recorded as a non-delivery (with the reason) rather than
# faked as a success. COMMS_PHARMACY_TO is the real distribution list, comma-separated;
# COMMS_DEMO_INBOX is the single-address demo fallback.
RESEND_API_KEY=
COMMS_FROM=stopgap@example.com
COMMS_PHARMACY_TO=
COMMS_DEMO_INBOX=

# Mock EHR formulary-flag webhook (Phase 4)
EHR_WEBHOOK_URL=http://localhost:4000/ehr/formulary-flag

# --- Demo mode (Phase 5, PROJECT_PLAN §11). Off locally; the VPS deploy turns it on. ---
# "on" = public read-only console: reviews/exception resolutions are refused server-side and
# the only visitor mutation is "Run a shortage" (fixed drug catalogue, rate limited).
STOPGAP_DEMO_MODE=off
# Daily LLM spend cap in USD, applied to every caller. Over it, routing is restricted to the
# free local model. Spend accumulates in the `llm_spend` table. Unset (the default) = no cap.
LLM_DAILY_USD_CAP=
DEMO_MAX_RUNS_PER_HOUR=6

# --- Audit chain hardening (Phase 6, §6.2) ---
# Keyed-HMAC secret for the audit chain. Set it and new rows are hashed with HMAC-SHA256
# (scheme "v2") so a write-only attacker cannot forge a valid chain; the key must live outside
# the DB (a KMS in prod). Unset (the default) keeps the bare-SHA256 "v1" scheme — honest
# non-configuration, and existing v1 rows keep verifying either way.
AUDIT_HMAC_KEY=
# Append-only file the hourly anchor writes (ts, maxAuditId, headHash) to. Point it at a
# Docker volume in prod; the parent directory is created on first write.
AUDIT_ANCHOR_FILE=.audit-anchors/anchors.log
# Optional RFC 3161 timestamp authority (e.g. https://freetsa.org/tsr). Set it and each anchor
# also submits the head hash for a signed timestamp token. Unset = the file is the only sink,
# recorded honestly as such (never a faked token).
AUDIT_TSA_URL=

# --- OIDC SSO / RBAC (Phase 6, §6.1) ---
# Auth.js (NextAuth v5) + Keycloak. Every var has a safe default so the local gate and the
# public demo run zero-config. Honest non-configuration: with AUTH_SECRET or the client secret
# UNSET, no one can sign in — the console runs read-only as the anonymous `viewer` and every
# mutation is refused (never a faked "authenticated" success). Set both (and STOPGAP_DEMO_MODE
# off) to enforce the role matrix. Swap Keycloak for Azure AD / Okta by changing the issuer URL
# + client id/secret only (no code change).
# Generate a real secret with:  openssl rand -base64 33
AUTH_SECRET=
# `docker compose up` seeds this realm + the stopgap-console client + one demo user per role.
KEYCLOAK_ISSUER=http://localhost:8080/realms/stopgap
KEYCLOAK_CLIENT_ID=stopgap-console
# DEV-ONLY seeded secret (deploy/keycloak/realm-stopgap.json). Rotate for any real deployment.
KEYCLOAK_CLIENT_SECRET=stopgap-console-dev-secret
# Seeded Keycloak demo users (realm-stopgap.json) — ALL passwords are DEV-ONLY throwaways:
#   viewer / viewer-dev · pharmacist / pharmacist-dev · director / director-dev · admin / admin-dev
# Keycloak bootstrap admin console (http://localhost:8080): admin / admin  (DEV-ONLY)

# --- Feed-resolution auto-detect (Phase 6, §6.6) ---
# Consecutive polls a monitored shortage must be MISSING from the feeds before its case is
# auto-resolved. Default 3: one absent poll is a flap, not a resolution. An explicit "resolved"
# status from a feed resolves immediately, regardless of this number.
FEED_RESOLVE_MISS_THRESHOLD=3
